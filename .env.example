# Copy to .env.local for `bun run dev`. .env.local is gitignored.

# Encrypts stored Radius and Sling passwords: openssl rand -base64 32
RADIUS_CREDENTIAL_KEY=
# CapMonster Cloud, for Sling's login captcha.
CAPMONSTER_API_KEY=

# The DynamoDB table. Either DynamoDB Local (see README) ...
TABLE_NAME=mathnasium-scheduling-dev
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
# ... or a real table: remove DYNAMODB_ENDPOINT and the keys above, set
# TABLE_NAME to the table (e.g. staging's TableName output) and use your
# own AWS credentials (AWS_PROFILE=...).
