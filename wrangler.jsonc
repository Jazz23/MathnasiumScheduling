{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mathnasium-scheduling",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-23",
  "upload_source_maps": true,
  // The React app is built by Vite (@cloudflare/vite-plugin), which also sets
  // the assets directory. Only the paths below reach the Worker first.
  // /signalr/* is Radius' live-update WebSocket (see worker/radiusProxy.ts).
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/radius/*", "/sling/*", "/signalr/*"]
  },
  // Set with `wrangler secret put` (and `--env staging`); locally in .dev.vars.
  // Also the source of the secret names in the generated types.
  "secrets": {
    "required": ["RADIUS_CREDENTIAL_KEY", "CAPMONSTER_API_KEY"]
  },
  "observability": {
    "enabled": true
  },

  // Bindings below aren't inherited by environments, so env.staging repeats
  // them. Keep the two in step.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mathnasium-scheduling",
      "database_id": "9a2d2066-3065-4cbf-a701-a4bb2c6b8c0e",
      "migrations_dir": "migrations"
    }
  ],
  // One AccountLock per app account: one Radius or Sling sign-in at a time.
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNT_LOCK", "class_name": "AccountLock" }]
  },
  // Workflow names are unique per Cloudflare account, so staging's differs.
  "workflows": [
    { "name": "sling-sign-in", "binding": "SLING_SIGN_IN", "class_name": "SlingSignIn" }
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountLock"] }],

  "env": {
    // Selected at build time: `CLOUDFLARE_ENV=staging bun run build`, then
    // `wrangler deploy` deploys mathnasium-scheduling-staging.
    "staging": {
      "secrets": {
        "required": ["RADIUS_CREDENTIAL_KEY", "CAPMONSTER_API_KEY"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mathnasium-scheduling-staging",
          // Placeholder: replace with the ID from
          // `wrangler d1 create mathnasium-scheduling-staging`.
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "durable_objects": {
        "bindings": [{ "name": "ACCOUNT_LOCK", "class_name": "AccountLock" }]
      },
      "workflows": [
        { "name": "sling-sign-in-staging", "binding": "SLING_SIGN_IN", "class_name": "SlingSignIn" }
      ]
    }
  }
}
