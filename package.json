{
	"name": "mathnasium-scheduling",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "oxlint",
		"preview": "bun run build && vite preview",
		"deploy": "bun run build && wrangler deploy",
		"deploy:staging": "CLOUDFLARE_ENV=staging bun run build && wrangler deploy",
		"types": "wrangler types",
		"typecheck": "wrangler types --check && tsc -b",
		"db:migrate": "wrangler d1 migrations apply mathnasium-scheduling --remote",
		"db:migrate:local": "wrangler d1 migrations apply mathnasium-scheduling --local",
		"db:migration:new": "wrangler d1 migrations create mathnasium-scheduling"
	},
	"dependencies": {
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.70.1",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"oxlint": "^1.90.0",
		"typescript": "~7.0.2",
		"vite": "^8.3.6",
		"wrangler": "^4.167.0"
	},
	"patchedDependencies": {
		"miniflare@5.20261117.0-beta": "patches/miniflare@5.20261117.0-beta.patch"
	}
}
